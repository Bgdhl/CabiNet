# CabiNet kiosk — no mouse arrow on a touch-only screen.
#
# The Pi's HDMI ports register as input devices ("vc4-hdmi-0", "vc4-hdmi-1":
# the HDMI-CEC remote control) and libinput classes them as keyboard +
# POINTER. A seat with a pointer makes the kiosk compositor (cage) draw a
# mouse arrow, parked in the middle of the touchscreen for good — the
# touchscreen itself is touch only, so nothing ever moves it.
#
# This tells libinput to leave those two devices alone. With no pointer on
# the seat, cage draws no cursor. A real mouse, if one is ever plugged in,
# is a different device and still works.
#
# Installed by deploy/kiosk_setup.sh (new kiosks) and deploy/kiosk_pointer.sh
# (a kiosk that is already set up). Remove with: sudo deploy/kiosk_pointer.sh --undo
ACTION=="add|change", SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="vc4-hdmi*", ENV{LIBINPUT_IGNORE_DEVICE}="1"
